modules = ["nodejs-20", "postgresql-16"]
run = "npm run dev"
entrypoint = "replit.md"

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[deployment]
# Reserved VM recommended for workshop days (stable WebSockets, no cold starts).
run = ["sh", "-c", "npm start"]
build = ["sh", "-c", "npm run build"]

[[ports]]
localPort = 5000
externalPort = 80
